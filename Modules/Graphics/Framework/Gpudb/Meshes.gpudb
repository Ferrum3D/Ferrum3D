import Meshlets
{
	cpp <Graphics/Core/Meshlet.h>
	hlsl <Shaders/Core/Meshlet.hlsli>
}

table MeshLodInfoTable
	: Meshlets
{
    Core::MeshLodInfo m_info;
}

table MaterialInstanceTable
{
	BufferPointer m_materialParameters;
}

table MeshGroupTable
    : Meshlets
{
    BufferPointer m_geometry;
	DB::Slice<MeshLodInfoTable> m_lods;
	DB::Ref<MaterialInstanceTable> m_materialInstance;
    Core::MeshBoundsInfo m_bounds;
    uint32_t m_renderable;
}

table MeshMemberTable
{
    DB::Ref<MeshInstanceTable> m_instance;
}

table MeshBatchTable
{
    DB::Slice<MeshMemberTable> m_members;
    uint32_t m_passMask;
}

table MeshInstanceTable
{
	DB::Ref<MeshGroupTable> m_meshGroup;
	float4x4 m_transform;
	BufferPointer m_instanceData;
}
